import cv2
import mediapipe as mp
import os

mp_drawing = mp.solutions.drawing_utils
mp_drawing_styles = mp.solutions.drawing_styles
mp_face_mesh = mp.solutions.face_mesh

# Input files
IMAGE_FILES = ["dataset"]
image_dir = "dataset"
OUTPUT_DIR = "validation_mediapipe"
os.makedirs(OUTPUT_DIR, exist_ok=True)
filenames = os.listdir(image_dir)
with mp_face_mesh.FaceMesh(
    static_image_mode=True,
    max_num_faces=1,
    refine_landmarks=True,
    min_detection_confidence=0.5
) as face_mesh:
    for filename in filenames:
        image = cv2.imread(os.path.join(image_dir, filename))
        if image is None:
            print(f"Could not read {filename}")
            continue

        # Convert the BGR image to RGB before processing
        results = face_mesh.process(cv2.cvtColor(image, cv2.COLOR_BGR2RGB))

        if not results.multi_face_landmarks:
            print(f"No face landmarks found in {filename}")
            continue
        print(f"FILE:{filename} ")
        h, w, _ = image.shape
        for face_landmarks in results.multi_face_landmarks:
            # Get all landmark coordinates
            xs = [lm.x for lm in face_landmarks.landmark]
            ys = [lm.y for lm in face_landmarks.landmark]

            # Compute bounding box in pixel coordinates
            x_min = int(max(min(xs) * w, 0))
            y_min = int(max(min(ys) * h, 0))
            x_max = int(min(max(xs) * w, w))
            y_max = int(min(max(ys) * h, h))

            # Add small padding (optional)
            pad = 20
            x_min = max(x_min - pad, 0)
            y_min = max(y_min - pad, 0)
            x_max = min(x_max + pad, w)
            y_max = min(y_max + pad, h)

            # Crop the face ROI
            cropped_face = image[y_min:y_max, x_min:x_max]

            # Save cropped image
            cropped_path = os.path.join(OUTPUT_DIR, f"{filename}_cpy.png")
            cv2.imwrite(cropped_path, cropped_face)
